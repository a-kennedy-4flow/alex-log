# One place to change. Every script in this directory reads this file.
# Drop your own model in here and nothing else needs editing.
#
# Every value can also be overridden for a single run without editing anything:
#   MODEL_ID="microsoft/Phi-4-mini-instruct" QUANT=fp16 ./run_transformers.sh "hello"

# --- the safetensors path (transformers and vLLM) -------------------------
# Any Hugging Face repo id that holds .safetensors weights.
MODEL_ID="${MODEL_ID:-Qwen/Qwen2.5-7B-Instruct}"

# How the weights are held in VRAM. One of: 4bit 8bit fp16
# 4bit is the default because a 7B model then needs about 4.5 GB not 15 GB.
QUANT="${QUANT:-4bit}"

# Context length. Drop this first when you run out of VRAM.
CTX="${CTX:-8192}"

# Share of the 10 GB that vLLM is allowed to claim.
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"

# --- the GGUF path (llama.cpp and Ollama) ---------------------------------
# A GGUF repo and the single file inside it that you want.
GGUF_REPO="${GGUF_REPO:-bartowski/Qwen2.5-7B-Instruct-GGUF}"
GGUF_FILE="${GGUF_FILE:-Qwen2.5-7B-Instruct-Q4_K_M.gguf}"

# Transformer layers pushed onto the GPU. 999 means all of them.
# Lower this to split a model that is too big between GPU and system RAM.
NGL="${NGL:-999}"

# --- shared ----------------------------------------------------------------
# Port for the OpenAI compatible servers.
PORT="${PORT:-8000}"

# Where downloaded weights land. About 5 GB per 7B model at 4 bit.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

# Faster downloads through Xet. Set to 0 if your network dislikes parallel
# connections. The older HF_HUB_ENABLE_HF_TRANSFER is deprecated in hub 1.x.
export HF_XET_HIGH_PERFORMANCE="${HF_XET_HIGH_PERFORMANCE:-1}"

# Needed only for gated repos such as Meta Llama. Get one at
# https://huggingface.co/settings/tokens then uncomment.
# export HF_TOKEN="hf_..."
