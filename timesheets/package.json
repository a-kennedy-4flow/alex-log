{
  "name": "timesheets",
  "version": "1.0.0",
  "private": true,
  "description": "4flow timesheet management and submission site",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm --filter @timesheets/web dev",
    "build": "pnpm --filter @timesheets/web build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "fixtures": "pnpm --filter @timesheets/extract-fixtures start",
    "test": "pnpm -r --no-bail test",
    "dev:api": "pnpm --filter @timesheets/api start",
    "bundle": "pnpm --filter @timesheets/api bundle",
    "synth": "pnpm --filter @timesheets/api bundle && pnpm --filter @timesheets/infra synth",
    "deploy": "pnpm --filter @timesheets/api bundle && pnpm --filter @timesheets/infra deploy"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
